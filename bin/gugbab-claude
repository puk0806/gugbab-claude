#!/bin/sh
# gugbab-claude — gugbab 하네스를 끼워 claude 를 실행하는 래퍼 (계획서 4장)
#   ① 업데이트 확인(갱신되면 새 래퍼로 다시 실행) ② 프로젝트 확인 ③ 조립 → ④ CLAUDE_CONFIG_DIR=<프로젝트별 설정 폴더> 로 claude 실행
#   claude 가 끝났을 때 재시작 표시(.gugbab-restart)가 있으면 지금 설치된 래퍼로 claude --continue 를 다시 띄운다 (대화 유지)
#   개발 모드: GUGBAB_HOME=<작업 트리> gugbab-claude  → 그 작업 트리를 바로 쓰고 자동 업데이트 끔
set -u

# 자기 위치 (심볼릭 링크를 따라감 — ~/.local/bin/gugbab-claude → ~/gugbab/bin/gugbab-claude)
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
code=$(cd "$(dirname "$self")/.." && pwd -P)

# 배포 모드는 GUGBAB_DEV=0 을 넘긴다 — claude 세션 안에서 다시 부를 때(/harness 의 status·on·off 등) 넘겨받은
# GUGBAB_HOME 때문에 개발 모드로 잘못 판정되면(자동 최신화 끔 표시 + 데이터가 ~/.gugbab-dev 로) 안 되므로 (2026-10-17)
if [ "${GUGBAB_DEV:-}" = "0" ]; then
  GUGBAB_HOME=$code
elif [ -n "${GUGBAB_HOME:-}" ]; then
  GUGBAB_DEV=1
else
  GUGBAB_HOME=$code
  GUGBAB_DEV=0
fi
export GUGBAB_HOME GUGBAB_DEV

command -v node >/dev/null 2>&1 || { echo "[gugbab] node 가 필요합니다 (18 이상)" >&2; exit 127; }
main="$GUGBAB_HOME/cli/main.js"

case "${1:-}" in
  status|doctor|update|on|off|preset|harness|compose|help|--help)
    exec node "$main" "$@" ;;
  --raw)
    shift
    exec claude "$@" ;;
esac

command -v claude >/dev/null 2>&1 || { echo "[gugbab] claude 를 찾지 못했습니다 — Claude Code 를 먼저 설치하세요" >&2; exit 127; }

# 자동 업데이트 — 갱신됐으면 새 버전의 래퍼로 다시 실행한다 (2026-10-19)
#   지금 도는 셸·node 는 업데이트 전 코드라, 그대로 가면 래퍼·cli 수정이 다음 실행에야 반영된다
#   다시 실행된 쪽(GUGBAB_REEXEC=1)은 업데이트를 건너뛴다 — 반복 실행 방지. 새 래퍼가 없으면 이 프로세스로 계속
#   GUGBAB_LAUNCH = 이번 실행 값. self-update 가 확인 결과를 이 값과 함께 남기고, 세션 시작 때 wrapper-version-check 훅이
#   같은 값일 때만 "하네스 vX — 최신 / vA → vB 업데이트" 를 화면에 보여 준다. 다시 실행된 쪽은 같은 값을 이어받는다
if [ "${GUGBAB_REEXEC:-}" != "1" ]; then
  GUGBAB_LAUNCH="$$-$(date +%s)"
  export GUGBAB_LAUNCH
  node "$main" self-update
  if [ $? -eq 10 ] && [ -f "$GUGBAB_HOME/bin/gugbab-claude" ]; then
    GUGBAB_REEXEC=1
    export GUGBAB_REEXEC
    exec sh "$GUGBAB_HOME/bin/gugbab-claude" "$@"
  fi
fi
unset GUGBAB_REEXEC

# 프로젝트에서 처음 실행이면 기본 프리셋 고르기 (터미널·-p 아님·설정 없음일 때만 묻는다, 실패해도 계속)
node "$main" first-run "$@" || true

cfg=$(node "$main" prepare --no-update) || { echo "[gugbab] 조립 실패 — gugbab-claude doctor 로 확인하세요 (하네스 없이: gugbab-claude --raw)" >&2; exit 1; }
[ -n "$cfg" ] && [ -d "$cfg" ] || { echo "[gugbab] 설정 폴더를 만들지 못했습니다: $cfg" >&2; exit 1; }
rm -f "$cfg/.gugbab-restart"

# claude 세션 안(/harness 커맨드·Bash)에서 이 하네스의 gugbab-claude 가 먼저 잡히게 — 커맨드에 ${…} 변수를 쓰면
# Claude Code 가 "실행 전에 검사할 수 없다" 며 거부하므로 이름만으로 부를 수 있어야 한다
PATH="$GUGBAB_HOME/bin:$PATH"
export PATH

# 이 세션을 띄운 래퍼의 하네스 커밋 — wrapper-version-check 훅이 설치본과 비교해, 세션 도중 업데이트되면 재시작을 안내한다
GUGBAB_WRAPPER_REV=$(git -C "$GUGBAB_HOME" rev-parse HEAD 2>/dev/null) || GUGBAB_WRAPPER_REV=
[ -n "$GUGBAB_WRAPPER_REV" ] || GUGBAB_WRAPPER_REV=unknown
export GUGBAB_WRAPPER_REV

# -p/--print(한 번 실행)는 다시 띄우지 않는다 — --continue 로 바꾸면 대화형이 떠 버린다
oneshot=
for a in "$@"; do
  case $a in -p|--print) oneshot=1 ;; esac
done

unset GUGBAB_JC
# claude 실행 + 재시작 반복 — 터미널에서는 작업 제어를 켠 dash 로 돌린다 (2026-10-19 결정 38)
#   작업 제어가 꺼진 sh 는 claude 를 자기 프로세스 그룹에 넣어, comux·tmux 가 이 칸을 claude 가 아니라 sh 로 본다
#   (에이전트 목록에 안 나옴). set -m 이면 claude 가 자기 그룹으로 터미널 앞에 선다
#   macOS /bin/sh(bash 3.2)는 set -m 이어도 claude 가 Ctrl+Z 로 멈춘 걸 알아채지 못해 칸이 멈추므로 dash 를 쓴다 (PoC)
#   claude 가 멈추면(작업이 남아 있으면) 래퍼도 멈춰 부모 셸로 돌아가고, fg 로 깨어나면 claude 를 다시 앞으로
#   dash 는 고정 경로만(PATH 의 가짜 dash 무시). 없거나 터미널이 아니거나(-p·파이프) GUGBAB_JOBCTL=0 이면 예전처럼 sh 로
# shellcheck disable=SC2016
loop='cfg=$1; oneshot=$2; main=$3; shift 3
jc=${GUGBAB_JC:-}; unset GUGBAB_JC
while :; do
  # CLAUDE_SECURESTORAGE_CONFIG_DIR= (빈 값) — 설정 폴더가 달라도 기본 키체인 로그인을 그대로 쓴다 (PoC 1, 문서에 없는 내부 변수)
  CLAUDE_CONFIG_DIR="$cfg" CLAUDE_SECURESTORAGE_CONFIG_DIR= claude "$@"
  rc=$?
  if [ -n "$jc" ]; then
    while jobs %1 >/dev/null 2>&1; do
      kill -STOP $$
      fg %1 >/dev/null 2>&1
      rc=$?
    done
  fi
  [ -f "$cfg/.gugbab-restart" ] || exit $rc
  rm -f "$cfg/.gugbab-restart"
  if [ -n "$oneshot" ]; then
    echo "[gugbab] 하네스가 바뀌었습니다 — 다음 실행부터 반영됩니다" >&2
    exit $rc
  fi
  echo "[gugbab] 바뀐 하네스로 다시 시작합니다 (대화 이어서)" >&2
  # 세션 도중 하네스가 업데이트됐을 수 있으니 지금 설치된 래퍼로 다시 실행한다 (업데이트는 건너뜀)
  if [ -f "$GUGBAB_HOME/bin/gugbab-claude" ]; then
    GUGBAB_REEXEC=1
    export GUGBAB_REEXEC
    exec sh "$GUGBAB_HOME/bin/gugbab-claude" --continue
  fi
  cfg=$(node "$main" prepare --no-update) || exit 1
  set -- --continue
done'
if [ -z "$oneshot" ] && [ "${GUGBAB_JOBCTL:-1}" != "0" ] && [ -t 0 ] && [ -t 1 ]; then
  for d in /bin/dash /usr/bin/dash; do
    [ -x "$d" ] || continue
    GUGBAB_JC=1 exec "$d" -c "set -m
$loop" gugbab-claude "$cfg" "$oneshot" "$main" "$@"
  done
fi
exec sh -c "$loop" gugbab-claude "$cfg" "$oneshot" "$main" "$@"
